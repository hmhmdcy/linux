config VIDEO_QCOM_CAMSS
	tristate "Qualcomm V4L2 Camera Subsystem driver"
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV
	depends on (ARCH_QCOM && IOMMU_DMA) || COMPILE_TEST
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select VIDEOBUF2_DMA_SG
	select VIDEOBUF2_VMALLOC
	select V4L2_FWNODE
	select V4L2_ISP

config VIDEO_QCOM_CAMSS_ICP_A5_CORE
	tristate
	depends on VIDEO_QCOM_CAMSS && IOMMU_DMA && OF && PM_GENERIC_DOMAINS && RESET_CONTROLLER

config VIDEO_QCOM_CAMSS_ICP_A5_MEMORY_TEST
	tristate
	depends on VIDEO_QCOM_CAMSS_ICP_A5_CORE && OF_OVERLAY

config VIDEO_QCOM_CAMSS_ICP_A5_POWER_TEST
	tristate
	depends on VIDEO_QCOM_CAMSS_ICP_A5_CORE && OF_OVERLAY && PM

config VIDEO_QCOM_CAMSS_ICP_A5_BOOT_TEST
	tristate
	depends on VIDEO_QCOM_CAMSS_ICP_A5_CORE && OF_OVERLAY
	select VIDEO_QCOM_CAMSS_ICP_A5_M2M

config VIDEO_QCOM_CAMSS_ICP_A5_M2M
	tristate
	depends on VIDEO_QCOM_CAMSS_ICP_A5_CORE && VIDEO_DEV
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_VMALLOC
